"use strict";
document.addEventListener("click", function(e) {
    var wall = e.target.closest(".wall");
    if (!wall) return;
    var spider = wall.querySelector(".spider");
    if (!spider) return;
    var wallRect = wall.getBoundingClientRect();
    var border = parseFloat(getComputedStyle(wall).borderLeftWidth);
    var mouseX = e.clientX;
    var mouseY = e.clientY;
    var newPositionX = mouseX - wallRect.x - spider.offsetWidth / 2 - border;
    var newPositionY = mouseY - wallRect.y - spider.offsetHeight / 2 - border;
    newPositionX = Math.max(0, Math.min(newPositionX, wall.clientWidth - spider.offsetWidth));
    newPositionY = Math.max(0, Math.min(newPositionY, wall.clientHeight - spider.offsetHeight));
    spider.style.left = "".concat(newPositionX, "px");
    spider.style.top = "".concat(newPositionY, "px");
});

